// sys's sidecar: src/, the system calls (posix.c, unix.c and spawn.c on POSIX,
// win.c, winreg.c, winmgmt.c and winspawn.c on Windows, and the stubs for what a
// platform lacks), compiled only into programs that call them.
c_sources = ["src/posix.c", "src/unix.c", "src/spawn.c", "src/win.c", "src/winreg.c", "src/winmgmt.c", "src/winspawn.c", "src/gssys_stubs.c"];
// Accounts, groups and shares (netapi32), sessions (wtsapi32).
c_libs_windows = ["advapi32", "netapi32", "wtsapi32"];

// Programs, not the package's modules.
exclude = ["examples", "test", "scripts"];
